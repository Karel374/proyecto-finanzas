# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- PostgreSQL local (Docker Compose) ---
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=finanzas
POSTGRES_PORT=5433

# Conexión que usa la app y Prisma
DATABASE_URL=postgresql://finanzas:cambia-esta-clave@localhost:5433/finanzas

# --- Autenticación (NextAuth) ---
# Genera uno con: npx auth secret  o  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (opcional en desarrollo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Acceso de desarrollo: solo funciona con NODE_ENV=development y este valor en true
ACCESO_DESARROLLO=true

# --- Cron diario ---
CRON_SECRET=

# --- Sentry (opcional) ---
SENTRY_DSN=
